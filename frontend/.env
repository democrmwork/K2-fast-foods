# ─────────────────────────────────────────────────────────────
# K2 Fast Foods — Frontend Environment
# ─────────────────────────────────────────────────────────────

# DEVELOPMENT (npm start):
# Leave REACT_APP_API_URL blank — the proxy in package.json handles it.
# React will forward requests to http://localhost:8080 automatically.
REACT_APP_API_URL=http://localhost:8080/backend/public/api/v1

# PRODUCTION (npm run build):
# Uncomment and set your real backend URL:
# REACT_APP_API_URL=https://yourdomain.com/k2fastfoods/backend/public/api/v1
